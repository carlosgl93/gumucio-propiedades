rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /properties/{propertyId} {
      // Anyone can read properties
      allow read: if true;
      // Only authenticated users can write, update, or delete properties
      allow write, update, delete: if request.auth != null;
    }

    // Postulaciones (job applications) — admin-only access
    match /postulaciones/{postulacionId} {
      allow read, write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches('.*@gumucio\\.cl'));
      match /documentos/{docId} {
        allow read, write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches('.*@gumucio\\.cl'));
      }
    }
  }
}
